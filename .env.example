# ColdTrace configuration — copy to .env and fill in the keys.
#
#   cp .env.example .env
#   ./scripts/setup_local.sh          # checks tooling + brings the stack up
#
# .env is gitignored on purpose: it holds real API keys and must never be
# pushed. Each machine keeps its own copy.
#
# Local compose MongoDB is the default; for Atlas paste your mongodb+srv URI
# here (ops-api, gateway and ai-agent all honor it — docker compose up -d
# with no other change).
MONGO_URI=
MONGO_DB=coldtrace

# Datadog — the only telemetry backend.
# Apps export OTLP to the local otel-collector (compose default
# otel-collector:4318); the collector ships traces, metrics and logs to
# Datadog via the native exporter (otelcol/config.yaml). DD_API_KEY is
# required: the collector and the Agent both need it.
# Dashboard + monitors land via ./datadog/apply-datadog.sh (also needs
# DD_APP_KEY).
OTEL_EXPORTER_OTLP_ENDPOINT=
DD_API_KEY=
DD_SITE=ap1.datadoghq.com
# DD_APP_KEY=      # dashboard/monitor authoring only (apply-datadog.sh)

# Fleet
DEVICES=FZ-001,FZ-002,FZ-003,FZ-004,FZ-005
FAULT_RATE=0.15
SIM_INTERVAL_SECONDS=5

# Gateway HTTP port on host (container listens on 8080 internally).
GATEWAY_PORT=8099

# Load generator (docker compose --profile loadgen up -d)
# LOADGEN_INTERVAL=1   # seconds between publishes/polls (lower = heavier)
# 10 LG-10x devices total; scale by adding services or lowering the interval

# AI RCA engine — pick ONE provider; leave all keys unset to run keyless
# (RCA falls back to a deterministic, data-grounded template engine).
#
# 1) OpenAI-compatible endpoint (api.openai.com, or a gateway such as the
#    OneNexus catalog / Datadog LLM Gateway — no code change to swap).
#    This is the engine the demo runs on.
# OPENAI_BASE_URL=https://catalog.onenexus.cloud/v1
# OPENAI_API_KEY=<your key>
# OPENAI_MODEL=<model id served by that gateway>
#
# 2) Anthropic Messages API (wins over the OpenAI-compatible engine when set).
#    Get a key: console.anthropic.com -> API keys.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=            # default https://api.anthropic.com

# Cursor Cloud Agents engine for ops RCA (wins over both chat engines when set).
# Get a key: cursor.com dashboard -> API Keys. CURSOR_REPO = repo the cloud
# agent runs against (e.g. https://gitlab.id.vin/<group>/coldtrace). Optional
# overrides: CURSOR_API_URL (default https://api.cursor.com),
# CURSOR_MODEL (default composer-2.5).
# CURSOR_API_KEY=
# CURSOR_REPO=
